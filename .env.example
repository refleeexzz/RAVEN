# RAVEN local dev environment.
# Copy this file to `.env` (compose reads .env automatically):
#   cp .env.example .env
# Every value here is a DEV-ONLY default. Never use them in production.

# Shared by auth and gateway to sign/verify JWTs.
# The code falls back to this same dev default when the var is unset,
# so a missing .env never blocks a fresh clone.
JWT_SECRET=dev-only-secret-change-me

# Log verbosity for every service: debug | info | warn | error
LOG_LEVEL=info
